{
  "name": "heroscape-map-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host --force",
    "lint": "npx @biomejs/biome lint --write ./src",
    "format": "npx biome format --write src/",
    "build": "tsc -b && node --max-old-space-size=4096 node_modules/vite/bin/vite.js build",
    "textures:pack": "node scripts/pack-textures.mjs",
    "textures:check": "node scripts/pack-textures.mjs --check",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/material": "^6.1.6",
    "@mui/x-data-grid": "^7.29.13",
    "@react-pdf/renderer": "^4.3.0",
    "@react-three/drei": "^9.116.0",
    "@react-three/fiber": "^8.17.10",
    "@sentry/react": "^11.11.0",
    "@sentry/vite-plugin": "^11.11.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-process": "~2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@types/papaparse": "^5.3.16",
    "@types/three": "^0.170.0",
    "clipper-lib": "^6.4.2",
    "fflate": "^0.8.3",
    "immer": "^11.2.9",
    "jsoncrush": "^1.1.8",
    "lodash": "^4.17.21",
    "nanoid": "^6.0.2",
    "notistack": "^3.0.1",
    "opentype.js": "^1.3.4",
    "papaparse": "^5.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hotkeys-hook": "^5.4.0",
    "react-icons": "^5.3.0",
    "react-image-crop": "^11.0.10",
    "wouter": "^3.13.0",
    "zundo": "^2.3.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "1.65.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/clipper-lib": "^6.4.0",
    "@types/lodash": "^4.17.27",
    "@types/opentype.js": "^1.3.9",
    "@types/papaparse": "^5.3.16",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "bmp-js": "^0.1.0",
    "globals": "^17.14.0",
    "papaparse": "^5.5.2",
    "pngjs": "^7.0.0",
    "typescript": "~5.9.3",
    "vite": "6.4.6",
    "vitest": "4.1.12"
  },
  "overrides": {
    "unplugin": "1.16.1"
  }
}
