{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Hexoscape",
  "version": "1.0.15",
  "identifier": "com.local.hexoscape",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Hexoscape",
        "width": 1000,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://*.sentry.io https://*.ingest.sentry.io;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY3RjMzRjUyOTc1RkNGNgpSV1QyL0hVcDlUTi9ENkt0WGE0VENmZ3NJZ3JtL0xGbUl3WG80T2Z5YVZHcHZNQTNqZGxRL3BFOQo=",
      "endpoints": [
        "https://github.com/Dissolutio/heroscape-map-editor/releases/latest/download/latest.json"
      ]
    }
  }
}